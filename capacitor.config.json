{
  "appId": "com.chatcell.app",
  "appName": "ChatCell",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": true,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
